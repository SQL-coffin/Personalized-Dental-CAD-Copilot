{
  "name": "cad-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "CAD Copilot 前端交互原型（模拟 Runtime，合成数据）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
